{
  "name": "@apps/frontend",
  "private": true,
  "type": "module",
  "version": "1.1.0",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src",
    "start": "cross-env NODE_ENV=production tsx src",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --ssr src/entryServer.ts --outDir dist/server",
    "build": "npm run build:client && npm run build:server",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "vue-tsc --noEmit",
    "generate:openapi": "openapi-typescript ../openApi/openapi/openapi.yaml --output ./src/types/openapi.ts --enum-values"
  },
  "dependencies": {
    "@etonee123x/shared": "github:etonee123x/shared",
    "@mdi/js": "^7.4.47",
    "@tanstack/vue-query": "^5.100.11",
    "@unhead/vue": "^3.1.0",
    "@vueuse/core": "^14.3.0",
    "@vueuse/integrations": "^14.3.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "is-mobile": "^5.0.0",
    "negotiator": "^1.0.0",
    "ofetch": "^1.5.1",
    "sortablejs": "^1.15.7",
    "temporal-polyfill": "^0.3.2",
    "universal-cookie": "^8.1.2",
    "uuid": "^14.0.0",
    "vue": "^3.5.34",
    "vue-i18n": "^11.4.4",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.4.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^24.12.0",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/parser": "^8.59.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/compiler-sfc": "^3.5.34",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "eslint-plugin-vue": "^10.9.1",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "globals": "^17.6.0",
    "openapi-fetch": "^0.15.2",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vue-tsc": "^3.3.1"
  }
}
